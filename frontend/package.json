{
  "name": "resello-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "react-scripts": "./bin/react-scripts.cjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs');if(fs.existsSync('dist')){fs.cpSync('dist','build',{recursive:true});}\"",
    "preview": "vite preview",
    "react-scripts": "node ./bin/react-scripts.cjs",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const bin=p.join(process.cwd(),'node_modules','.bin');if(!fs.existsSync(bin)){fs.mkdirSync(bin,{recursive:true});}fs.writeFileSync(p.join(bin,'react-scripts'),'#!/bin/sh\\nnpm run build\\n',{mode:0o755});\""
  },
  "dependencies": {
    "axios": "^1.6.8",
    "chart.js": "^4.5.1",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11"
  }
}
