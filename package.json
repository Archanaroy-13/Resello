{
  "name": "resello",
  "private": true,
  "version": "1.0.0",
  "bin": {
    "react-scripts": "./bin/react-scripts.cjs"
  },
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "react-scripts": "node ./bin/react-scripts.cjs",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');const bin=p.join(process.cwd(),'node_modules','.bin');if(!fs.existsSync(bin)){fs.mkdirSync(bin,{recursive:true});}fs.writeFileSync(p.join(bin,'react-scripts'),'#!/bin/sh\\nnpm run build\\n',{mode:0o755});\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  }
}
